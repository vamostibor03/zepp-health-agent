# =============================================================================
# WatchData configuration
# Copy this file to `.env` for local runs and put your REAL values there.
# `.env` is git-ignored; THIS file (.env.example) is committed, so it must
# only ever contain placeholders -- never real secrets.
# In GitHub Actions, set each value as a repository *secret*
# (Settings -> Secrets and variables -> Actions).
# =============================================================================

# --- Zepp / Amazfit account ---------------------------------------------------
# Two ways to authenticate. Pick ONE:
#
# (A) TOKEN MODE  <-- recommended. No login calls, so it can't be rate limited
#     or account-locked. The token lasts several weeks, then re-extract it.
#       1. Open https://user.huami.com/privacy/index.html and log in.
#       2. Open DevTools (F12) -> Application -> Cookies.
#       3. Copy the value of the "apptoken" cookie into ZEPP_APP_TOKEN.
#       4. Find your user id in the Zepp app (Profile) or any API response.
ZEPP_APP_TOKEN=
ZEPP_USER_ID=
#
# (B) CREDENTIAL MODE  <-- fallback. Uses email/password to log in. Can be
#     rate limited (HTTP 429) if you retry too often.
ZEPP_EMAIL=
ZEPP_PASSWORD=

# Server region for your account. One of: us, de (europe), or "global"/cn.
# Most European accounts use "de"; try "us" if "de" returns no data.
ZEPP_REGION=de

# --- LLM (OpenAI-compatible) --------------------------------------------------
OPENAI_API_KEY=
# Any OpenAI chat model, or a compatible one behind a custom base URL.
LLM_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint (e.g. OpenRouter, Groq, local).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Telegram -----------------------------------------------------------------
# Create a bot with @BotFather to get the token.
TELEGRAM_BOT_TOKEN=
# Your chat id. Message your bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find "chat":{"id":...}.
TELEGRAM_CHAT_ID=

# --- Misc ---------------------------------------------------------------------
# Path to the SQLite history database (committed back to the repo by CI).
DATABASE_PATH=data/health.db
# IANA timezone used to decide what "yesterday" means, e.g. Europe/Berlin.
TIMEZONE=Europe/Berlin
